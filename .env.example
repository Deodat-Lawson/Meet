# ---------------------------------------------------------------- required
# The address clients will send RTP to. Must be the host's public IP (or the LAN
# IP for a local deployment) — never a Docker-internal address.
PUBLIC_IP=203.0.113.10

# Public hostname; used by Caddy to obtain a TLS certificate.
DOMAIN=meet.example.com

# Sign join tokens. Generate with: openssl rand -base64 48
JWT_SECRET=change-me

# TURN credentials. Long-term credentials shared by coturn and the clients.
TURN_USERNAME=meet
TURN_PASSWORD=change-me-too

# ---------------------------------------------------------------- optional
CORS_ORIGINS=*
ROOM_MAX_PEERS=100
LOG_LEVEL=info

# Server-side recording writes one WebM per participant plus a compose.sh that
# grids them offline. Requires ffmpeg in the image.
RECORDING_ENABLED=false

# mediasoup
MEDIASOUP_WORKERS=8
MEDIASOUP_USE_WEBRTC_SERVER=true
MEDIASOUP_WEBRTC_SERVER_PORT=44444
MEDIASOUP_LOG_LEVEL=warn
