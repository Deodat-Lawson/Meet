node_modules/
dist/
build/
recordings/
*.log
.DS_Store
.env
.env.local

# Locally generated development TLS material — never commit private keys.
infra/certs/*.pem

# Android / React Native
packages/mobile/android/.gradle/
packages/mobile/android/app/build/
packages/mobile/android/build/
packages/mobile/android/local.properties
packages/mobile/android/.cxx/
*.keystore
!debug.keystore
packages/mobile/.expo/

# Compiled output must never land beside sources. Vite prefers vite.config.js
# over vite.config.ts, so a stale emitted config silently shadows the real one.
packages/web/src/**/*.js
packages/web/src/**/*.js.map
packages/web/src/**/*.d.ts
packages/web/src/**/*.d.ts.map
packages/web/vite.config.js
packages/web/vite.config.js.map
packages/web/vite.config.d.ts
packages/web/vite.config.d.ts.map
*.tsbuildinfo

# Electron desktop build output (DMGs are release artifacts, not source)
packages/desktop/dist/
packages/desktop/release/
packages/desktop/node_modules/

# ...but packages/desktop/build holds packaging *inputs* — the icon artwork, the
# generated .icns and the hardened-runtime entitlements. The blanket `build/`
# rule above hides them, and without them a fresh clone cannot package the app.
!packages/desktop/build/
!packages/desktop/build/**
