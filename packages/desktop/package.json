{
  "name": "@meet/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Team Studio for macOS — private video meetings with screen sharing",
  "author": "Meet",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:universal": "npm run build && electron-builder --mac --universal --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
