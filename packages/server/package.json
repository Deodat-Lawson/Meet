{
  "name": "@meet/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:e2e": "tsx test/e2e.ts",
    "test:e2e:cross": "tsx test/e2e-cross-platform.ts",
    "test:e2e:lobby": "tsx test/e2e-lobby.ts",
    "test:e2e:i18n": "tsx test/e2e-i18n.ts",
    "test:layout": "tsx test/verify-layout.mts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "@meet/protocol": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mediasoup": "^3.15.4",
    "nanoid": "^5.0.9",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "puppeteer": "^25.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
